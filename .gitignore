# ============================================================
# KABISIG .gitignore
# ============================================================

# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Next.js build output
frontend/.next/
.next/
out/

# Backend build output
backend/dist/
dist/
build/

# Environment files
.env
.env.local
.env.*.local

# Backup files
*.bak
*.bak-*
*.old
*.orig
*.rej
*.save
*.tmp
*~

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript cache
*.tsbuildinfo

# Editor
.vscode/*
!.vscode/settings.json
.idea/

# LaTeX intermediates (if thesis source lives here)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.lof
*.lot
*.nav
*.out
*.snm
*.synctex.gz
*.toc
*.vrb
*.bak.*
